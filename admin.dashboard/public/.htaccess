<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep real files and API requests with the server. Every other request is
  # a client-side React route and must load the SPA entry point.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
